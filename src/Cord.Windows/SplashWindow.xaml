<Window x:Class="Cord.Windows.SplashWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cord">
  <!--
    Заставка при запуске (T58), как у Discord: маленькое окно без рамки, знак Cord и одна строка о том, что
    происходит. Тёмная всегда — она появляется раньше, чем Cord прочтёт выбранную тему, — и в цветах заставки
    установщика (brand/installer). Номера версии здесь нет: его показывает только «О программе».
  -->
  <Grid x:Name="Root" RequestedTheme="Dark" Padding="28,0,28,24">
    <Grid.Background>
      <RadialGradientBrush Center="0.5,0.34" GradientOrigin="0.5,0.34" RadiusX="0.8" RadiusY="0.6">
        <GradientStop Color="#FF1A2547" Offset="0" />
        <GradientStop Color="#FF111419" Offset="1" />
      </RadialGradientBrush>
    </Grid.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" MinHeight="112" />
    </Grid.RowDefinitions>
    <!-- Знак — тот же, что в шапке главного окна и в установщике: три полосы под −15° на плитке цвета Cord. -->
    <Border Width="88" Height="88" Margin="0,24,0,0" CornerRadius="22" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource CordAccent}" AutomationProperties.Name="Cord">
      <Viewbox Width="46" Height="46">
        <Canvas Width="30" Height="30">
          <Rectangle Canvas.Left="2" Canvas.Top="6" Width="6" Height="18" RadiusX="3" RadiusY="3" Fill="White">
            <Rectangle.RenderTransform><RotateTransform Angle="-15" CenterX="3" CenterY="9" /></Rectangle.RenderTransform>
          </Rectangle>
          <Rectangle Canvas.Left="12" Canvas.Top="0.5" Width="6" Height="29" RadiusX="3" RadiusY="3" Fill="White">
            <Rectangle.RenderTransform><RotateTransform Angle="-15" CenterX="3" CenterY="14.5" /></Rectangle.RenderTransform>
          </Rectangle>
          <Rectangle Canvas.Left="22" Canvas.Top="4" Width="6" Height="22" RadiusX="3" RadiusY="3" Fill="White">
            <Rectangle.RenderTransform><RotateTransform Angle="-15" CenterX="3" CenterY="11" /></Rectangle.RenderTransform>
          </Rectangle>
        </Canvas>
      </Viewbox>
    </Border>
    <!-- Одна строка и тонкая полоса под ней. Кнопки — только при сбое: «Повторить» и ссылка, которая открывает Cord как есть. -->
    <StackPanel Grid.Row="1" Spacing="14" VerticalAlignment="Top">
      <TextBlock x:Name="Status" Text="Проверяем обновления…" FontSize="13" LineHeight="19" MaxLines="3" TextAlignment="Center" TextWrapping="Wrap" Foreground="#FFE9ECF1" AutomationProperties.LiveSetting="Polite" />
      <ProgressBar x:Name="Bar" Width="180" Maximum="100" IsIndeterminate="True" Foreground="{StaticResource CordAccent}" />
      <StackPanel x:Name="Choice" Spacing="4" Visibility="Collapsed">
        <Button x:Name="Retry" Content="Повторить" Click="Retry_Click" HorizontalAlignment="Center" Height="36" Padding="24,0" Background="{StaticResource CordAccent}" Foreground="White" BorderThickness="0" CornerRadius="10" />
        <HyperlinkButton Content="Открыть Cord" Click="Open_Click" HorizontalAlignment="Center" FontSize="12" Foreground="#FF9DB4FF" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
