            <Path Data="M106.01 25.78Q104.94 25.78 104.21 25.06Q103.49 24.34 103.49 23.28Q103.49 22.22 104.21 21.51Q104.94 20.79 106.01 20.79Q107.08 20.79 107.8 21.51Q108.53 22.22 108.53 23.28Q108.53 24.34 107.8 25.06Q107.08 25.78 106.01 25.78Z" Fill="{StaticResource CordAccent}" />
          </Canvas>
        </Viewbox>
      </Grid>
    </Grid>
    <SplitView x:Name="NavigationSplit" Grid.Row="1" DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="244" CompactPaneLength="0" PaneBackground="Transparent">
      <SplitView.Pane>
        <Grid x:Name="Sidebar" Padding="14,20,14,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Spacing="8">
            <Button x:Name="HomeNavigation" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="48" Click="Home_Click" Background="Transparent" BorderThickness="0" CornerRadius="10">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <FontIcon Glyph="" FontSize="18" />
                <TextBlock Text="Главная" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="48" Click="Create_Click" Background="{StaticResource CordAccent}" Foreground="White" BorderThickness="0" CornerRadius="10">
              <StackPanel Orientation="Horizontal" Spacing="14">
                    <FontIcon Glyph="" FontSize="17" />
                <TextBlock Text="Новая встреча" VerticalAlignment="Center" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,34,0,12">
            <StackPanel Spacing="12">
              <Grid Margin="10,0,4,0">
                <TextBlock Text="ИЗБРАННОЕ" CharacterSpacing="100" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Width="32" Height="32" Padding="6" Background="Transparent" BorderThickness="0" Click="Refresh_Click" AutomationProperties.Name="Обновить избранное" ToolTipService.ToolTip="Обновить избранное">
                  <FontIcon Glyph="" FontSize="13" />
                </Button>
              </Grid>
              <ListView x:Name="FavoriteList" ItemsSource="{x:Bind Model.Favorites}" SelectionMode="Single"
                  CanDragItems="True" CanReorderItems="True" AllowDrop="True" IsItemClickEnabled="True"
                  DragItemsStarting="Favorites_DragItemsStarting" DragItemsCompleted="Favorites_DragItemsCompleted"
                  ItemClick="Favorites_ItemClick" ContextRequested="Favorites_ContextRequested" AutomationProperties.Name="Избранные комнаты. Перетащите для изменения порядка">
                <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="0" />
                </Style></ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="core:FavoriteRoom">
                    <Grid ColumnSpacing="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>

                    <Border Padding="10,10" Margin="0,2">
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="24" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="#" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontSize="13" />
                          <TextBlock Text="{x:Bind DisplayCode}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Button Grid.Column="1" Tag="{x:Bind RoomId}" Click="FavoriteSettings_Click" Content="…" Width="32" Padding="4" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Настройки избранной комнаты" />
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
              <TextBlock Text="Места, куда хочется возвращаться." Margin="10,4,10,0" TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
          </ScrollViewer>
          <!--
            Ни номера версии, ни плашки обновления в панели нет (T58): номер показывает только «О программе»,
            а найденное обновление не ждёт нажатия — его ставит заставка при запуске (SplashWindow).
          -->
          <StackPanel Grid.Row="2" Spacing="14">
            <Button Click="Settings_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="48" Background="Transparent" BorderThickness="0" CornerRadius="10">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <FontIcon Glyph="" FontSize="18" />
                <TextBlock Text="Настройки" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="8,0" />
            <!-- The profile block is where a person looks for their own settings, so it is the
                 way into them; the server button beside it opens the server list for the same
                 reason. Both used to be a label under a button somewhere above. -->
            <Grid ColumnSpacing="4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button Click="Profile_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,8" Background="Transparent" BorderThickness="0" CornerRadius="10" AutomationProperties.Name="Профиль и аватар" ToolTipService.ToolTip="Имя и картинка профиля">
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <!-- The picture belongs to the page and arrives with the state message.
                       An ellipse with no image draws nothing, so the placeholder behind it
                       stays visible and the picture is round without clipping tricks. -->
                  <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="18" Width="36" Height="36">
                    <Grid>
                      <FontIcon Glyph="" FontSize="17" />
                      <Ellipse Width="36" Height="36">
                        <Ellipse.Fill>
                          <ImageBrush ImageSource="{x:Bind Model.Avatar, Mode=OneWay}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                      </Ellipse>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="{x:Bind Model.Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="12" />
                    <TextBlock Text="{x:Bind Model.ServerLabel, Mode=OneWay}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                </Grid>
              </Button>
              <Button Grid.Column="1" Click="Servers_Click" Width="36" Height="36" Padding="0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" CornerRadius="10" AutomationProperties.Name="Серверы" ToolTipService.ToolTip="Сменить сервер">
                <FontIcon Glyph="" FontSize="15" />
              </Button>
            </Grid>
          </StackPanel>
        </Grid>
      </SplitView.Pane>
      <Border x:Name="WorkspaceFrame" Margin="0,0,12,12" CornerRadius="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid>
          <ContentControl x:Name="WorkspaceHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
          <ProgressRing IsActive="{x:Bind Model.Loading, Mode=OneWay}" Width="40" Height="40" IsHitTestVisible="False" />
          <StackPanel VerticalAlignment="Top" Margin="16" Spacing="8">
            <InfoBar IsOpen="{x:Bind Model.HasError, Mode=TwoWay}" Title="Соединение" Message="{x:Bind Model.Error, Mode=OneWay}" Severity="Warning">
              <InfoBar.ActionButton>
                <Button Content="Открыть повторно" Click="Retry_Click" />
              </InfoBar.ActionButton>
            </InfoBar>
          </StackPanel>
        </Grid>
      </Border>
    </SplitView>
  </Grid>
</Window>