{
  "name": "cord-desktop",
  "productName": "Cord",
  "version": "1.0.5",
  "description": "Cord — видеовстречи, экран и совместный просмотр",
  "author": "Cord",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-preload.mjs && node scripts/copy-shell.mjs && node scripts/check-dist.mjs",
    "icons": "node scripts/make-icons.mjs",
    "build:native": "node scripts/build-native.mjs",
    "test:native": "cargo test --manifest-path native/Cargo.toml",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "playwright test -c test/e2e/playwright.config.ts",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "sign-manifest": "node scripts/sign-manifest.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "js-yaml": "4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.19.2",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.27.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
